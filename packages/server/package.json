{
  "name": "@chrono/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:express --external:redis --external:socket.io --external:zod --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@chrono/shared": "*",
    "express": "^5.1.0",
    "redis": "^5.8.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
