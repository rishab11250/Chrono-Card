{
  "name": "chrono-card",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev -w @chrono/server\" \"npm run dev -w @chrono/client\"",
    "build": "npm run typecheck && npm run build -w @chrono/client && npm run build -w @chrono/server",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "typecheck:all": "tsc --noEmit",
    "start": "npm run start -w @chrono/server",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:pdf": "node scripts/pdf.mjs"
  },
  "dependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  }
}
