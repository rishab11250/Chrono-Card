# Copy server settings to your shell, hosting environment, or packages/server/.env.
# To load a local .env explicitly: node --env-file=.env packages/server/dist/index.js
PORT=3001
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001
# Omit REDIS_URL for local in-memory rooms. Configure it for restart recovery.
# REDIS_URL=redis://localhost:6379
# Persistent SQLite directory. Default: data/ in the server working directory.
# DATA_DIR=/var/data
# Client build-time setting (packages/client/.env.local or hosting dashboard).
# Leave unset for the Vite proxy or same-origin deployment.
# VITE_SERVER_URL=https://your-chrono-server.onrender.com
